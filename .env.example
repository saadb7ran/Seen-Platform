# PostgreSQL: use the pooled URL for application traffic and a direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional: OpenAI-powered writing/speaking review and speech transcription.
OPENAI_API_KEY=""
OPENAI_GRADING_MODEL="gpt-4o-mini"

# Optional: private S3-compatible bucket for audio recordings.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
S3_BUCKET=""
# For Cloudflare R2 use https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# Set these only in a trusted environment when bootstrapping the first administrator.
PLATFORM_ADMIN_USERNAME=""
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NAME=""
